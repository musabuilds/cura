# --- API ---
CURA_ENVIRONMENT=development
CURA_DATABASE_URL=postgresql+psycopg://cura:cura@localhost:5432/cura
# 32+ random bytes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
CURA_JWT_SECRET=
CURA_JWT_ISSUER=https://api.cura.jo
CURA_PUBLIC_BASE_URL=http://127.0.0.1:8000
CURA_RATE_ANONYMOUS_PER_MIN=60
CURA_RATE_APP_PER_MIN=600

# --- Refresh agent (any OpenAI-compatible endpoint serving an open-weight model) ---
CURA_LLM_BASE_URL=http://localhost:11434/v1
CURA_LLM_MODEL=qwen2.5:7b-instruct
CURA_LLM_API_KEY=
# Optional: post proposals to a live API instead of writing staging files
CURA_API_URL=
CURA_AGENT_TOKEN=
