{
  "$defs": {
    "Bio": {
      "additionalProperties": false,
      "description": "A doctor's own words about their practice, in each language. Public.",
      "properties": {
        "en": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        },
        "ar": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar"
        }
      },
      "title": "Bio",
      "type": "object"
    },
    "Grade": {
      "enum": [
        "consultant",
        "specialist",
        "resident",
        "general_practitioner",
        "unknown"
      ],
      "title": "Grade",
      "type": "string"
    },
    "Name": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        },
        "ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ar"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "title": "Name",
      "type": "object"
    },
    "PractitionerContact": {
      "additionalProperties": false,
      "description": "Only what the doctor chose to publish. Private numbers and a private email never enter the record\n(they live in `practitioner_private`, readable by the owner only), so they cannot leak through a\nread, the change feed, the history or the open dataset.",
      "properties": {
        "phones": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PublicPhone"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phones"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 254,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        }
      },
      "title": "PractitionerContact",
      "type": "object"
    },
    "PublicPhone": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "pattern": "^\\+[1-9]\\d{6,14}$",
          "title": "Number",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "number"
      ],
      "title": "PublicPhone",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "last_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified At"
        }
      },
      "required": [
        "completeness",
        "confidence"
      ],
      "title": "Quality",
      "type": "object"
    },
    "RatingSummary": {
      "additionalProperties": false,
      "description": "Aggregated from Cura's own reviews (`/v1/.../reviews`). Never copied from Google.",
      "properties": {
        "overall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "title": "Dimensions",
          "type": "object"
        }
      },
      "title": "RatingSummary",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "source"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Status": {
      "enum": [
        "active",
        "temporarily_closed",
        "permanently_closed",
        "merged",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^JO-PRC-\\d{6}$",
      "title": "Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "active"
    },
    "replaced_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaced By"
    },
    "name": {
      "$ref": "#/$defs/Name"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "gender": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gender"
    },
    "grade": {
      "$ref": "#/$defs/Grade",
      "default": "unknown"
    },
    "specialty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Specialty"
    },
    "subspecialties": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subspecialties"
    },
    "languages": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Languages"
    },
    "qualifications": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualifications"
    },
    "bio": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bio"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "photo_url": {
      "anyOf": [
        {
          "maxLength": 500,
          "pattern": "^https://[^\\s<>\\\"']+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Photo Url"
    },
    "contact": {
      "anyOf": [
        {
          "$ref": "#/$defs/PractitionerContact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license_verified": {
      "default": false,
      "title": "License Verified",
      "type": "boolean"
    },
    "rating": {
      "$ref": "#/$defs/RatingSummary",
      "default": {
        "overall": null,
        "count": 0,
        "dimensions": {}
      }
    },
    "identifiers": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Identifiers",
      "type": "object"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "demo": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Demo"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "quality",
    "created_at",
    "updated_at"
  ],
  "title": "Practitioner",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NextMoveIntl/cura/main/schema/practitioner.schema.json"
}
